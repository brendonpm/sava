{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Sava",
  "version": "0.7.4",
  "description": "__MSG_extDesc__",
  "default_locale": "en",
  "permissions": ["storage", "scripting"],
  "optional_host_permissions": [
    "http://127.0.0.1/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://www.perplexity.ai/*",
    "https://perplexity.ai/*",
    "https://copilot.com/*",
    "https://www.copilot.com/*",
    "https://copilot.microsoft.com/*",
    "https://copilot.cloud.microsoft/*",
    "https://m365.cloud.microsoft/*",
    "https://chat.deepseek.com/*",
    "https://grok.com/*"
  ],
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "src/shared/settings.js",
        "src/shared/i18n.js",
        "src/shared/instruction.js",
        "src/emotion/emotions.js",
        "src/emotion/detect.js",
        "src/avatar/sprite-pack.js",
        "src/avatar/avatar.js",
        "src/content/adapters/registry.js",
        "src/content/adapters/claude.js",
        "src/content/adapters/gemini.js",
        "src/content/adapters/chatgpt.js",
        "src/content/adapters/perplexity.js",
        "src/content/adapters/copilot.js",
        "src/content/adapters/deepseek.js",
        "src/content/adapters/grok.js",
        "src/content/tag-hider.js",
        "src/content/watcher.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/sprites/*"],
      "matches": [
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://copilot.com/*",
        "https://www.copilot.com/*",
        "https://copilot.microsoft.com/*",
        "https://copilot.cloud.microsoft/*",
        "https://m365.cloud.microsoft/*",
        "https://chat.deepseek.com/*",
        "https://grok.com/*"
      ]
    }
  ]
}
